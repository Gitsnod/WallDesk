// WallDesk 版本与图标资源。
// 由 CMake configure_file 从 app.rc.in 生成到构建目录，版本号取自 project() 声明。
#include <windows.h>

@WALLDESK_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @WALLDESK_FILEVERSION@
 PRODUCTVERSION @WALLDESK_FILEVERSION@
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "WallDesk Project"
            VALUE "FileDescription", "@WALLDESK_DESCRIPTION@"
            VALUE "FileVersion", "@WALLDESK_VERSION_STR@"
            VALUE "InternalName", "WallDesk"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "WallDesk.exe"
            VALUE "ProductName", "WallDesk"
            VALUE "ProductVersion", "@WALLDESK_VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
